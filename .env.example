# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Prisma format).
# Local dev example (Homebrew Postgres, no password, default user):
#   postgresql://<your-os-username>@localhost:5432/customer_support_agent?schema=public
# Production example (Neon/Supabase): use the connection string they give you.
DATABASE_URL="postgresql://user@localhost:5432/customer_support_agent?schema=public"

# Separate database for integration tests (npm run test:db:setup), so tests
# never mutate demo/seed data used for the live demo.
TEST_DATABASE_URL="postgresql://user@localhost:5432/customer_support_agent_test?schema=public"

# Groq API key for the AI agent (free tier, OpenAI-compatible tool calling).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# Groq model id used by the agent orchestrator (see https://console.groq.com/docs/models).
GROQ_MODEL="llama-3.3-70b-versatile"
